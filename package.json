{
  "name": "mandarinvideogenerator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"node server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.js",
    "autopilot": "node scripts/autopilot.mjs run",
    "autopilot:generate": "node scripts/autopilot.mjs generate",
    "autopilot:regenerate": "node scripts/autopilot.mjs regenerate",
    "autopilot:upload": "node scripts/autopilot.mjs upload",
    "autopilot:update-meta": "node scripts/updateYoutubeMeta.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@napi-rs/canvas": "^1.0.3",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "execa": "^10.0.0",
    "googleapis": "^173.0.0",
    "hono": "^4.12.32",
    "pdfkit": "^0.19.1",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
